# Copy to .env.local (gitignored) and fill in. Both URLs come from the Convex deployment:
# the .convex.cloud URL for the client, the .convex.site URL for Better Auth's HTTP routes.
# Local backend: http://127.0.0.1:3310 and http://127.0.0.1:3311 (on Android, adb reverse both ports).
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
