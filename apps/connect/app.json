{
  "expo": {
    "name": "Citius Connect",
    "slug": "citius-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citiusconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.citiusholidays.connect",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-ios-dark.png",
        "tinted": "./assets/images/icon-ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1026",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.citiusholidays.connect"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1026",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Citius Connect uses the camera to photograph expense receipts.",
          "photosPermission": "Citius Connect uses your photos to attach expense receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
