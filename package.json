{
  "name": "citius-app",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "connect": "bun --cwd apps/connect start",
    "customer": "bun --cwd apps/customer start",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint": "bun --filter '*' lint",
    "doctor": "react-doctor --no-telemetry --yes"
  },
  "devDependencies": {
    "react-doctor": "0.9.22"
  }
}
